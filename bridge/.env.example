# mock = fake viewers for development, tiktok = real stream
LIVEBRIDGE_SOURCE=mock
# The TikTok account that is LIVE (without @)
TIKTOK_USERNAME=
# Optional Euler Stream sign-server key (raises the free rate limit): https://www.eulerstream.com
TIKTOK_SIGN_API_KEY=
# Long random string. Games connect to ws://HOST:PORT/ws?token=<this>
LIVEBRIDGE_TOKEN=change-me
# 127.0.0.1 = only this server can connect (Godot runs on the same VPS)
LIVEBRIDGE_HOST=127.0.0.1
LIVEBRIDGE_PORT=8765
LIVEBRIDGE_LOG_DIR=logs
LIVEBRIDGE_BANNED_WORDS=banned_words.txt
# Comma separated, matched against the whole comment
LIVEBRIDGE_JOIN_KEYWORDS=!join,join,دخول,ادخل
LIVEBRIDGE_MOCK_RATE=3
